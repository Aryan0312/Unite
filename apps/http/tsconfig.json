{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    
    // Add these two lines inside compilerOptions:
    "composite": true,
    "incremental": true,

    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  // Add dist to exclude explicitly to stop the loop
  "exclude": ["node_modules", "dist"] 
}
  